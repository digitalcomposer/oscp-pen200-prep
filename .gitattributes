# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Markdown
*.md text eol=lf

# JSON/YAML
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# HTML/CSS/JS
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Git
.gitattributes text
.gitignore text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.db binary
